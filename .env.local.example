# Copy to .env.local for local development.

# Empty = same-origin. The browser calls /api/* on whatever host it loaded
# (localhost / LAN IP / tunnel); next.config.mjs rewrites that to the backend
# below. Leave blank unless you host the API on a separate absolute origin.
NEXT_PUBLIC_API_URL=

# Where Next forwards /api/* server-side. Point this at your running backend.
# Local backend (from the Whatly-backend repo) listens on :8000.
BACKEND_INTERNAL_URL=http://localhost:8000
